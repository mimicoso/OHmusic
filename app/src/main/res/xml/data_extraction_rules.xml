<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="ohmusic.db" />
        <exclude domain="file" path="covers/" />
        <exclude domain="sharedpref" path="ohmusic_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ohmusic.db" />
        <include domain="sharedpref" path="ohmusic_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
